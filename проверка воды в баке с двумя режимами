import requests
import time
from datetime import datetime, timedelta

def smart_greenhouse_water_monitor():
    """Умный мониторинг теплицы с контролем наличия воды в баке"""
    
    headers = {"Authorization": "EPP3GHY67735"}
    
    sensors = {
        18: {"name": "Температура воздуха", "unit": "°C"},
        19: {"name": "Влажность почвы", "unit": "%", "min": 30},
        38: {"name": "Температура почвы", "unit": "°C"}
    }
    
    print("=== МОНИТОРИНГ НАЛИЧИЯ ВОДЫ В БАКЕ ТЕПЛИЦЫ ===")
    print("Критерий: почва должна быть холоднее воздуха на 2-5°C")
    print("=" * 60)
    
    while True:
        try:
            current_time = datetime.now()
            print(f"\n{current_time.strftime('%d.%m.%Y %H:%M:%S')}")
            print("-" * 50)
            
            sensor_values = {}
            alerts = []
            
            # Получаем данные за последние 24 часа для анализа тренда
            end_time = datetime.utcnow()
            start_time = end_time - timedelta(hours=24)
            
            for sensor_id, sensor_info in sensors.items():
                params = {
                    "start": start_time.strftime("%Y-%m-%dT%H:%M:%SZ"),
                    "end": end_time.strftime("%Y-%m-%dT%H:%M:%SZ"),
                    "page": 1,
                    "range": 50
                }
                
                url = f"https://api.iot.robolatoriya.com/device/10/getSensorData/{sensor_id}"
                response = requests.get(url, headers=headers, params=params)
                
                if response.status_code == 200:
                    data = response.json()
                    
                    if data and 'dataset' in data and 'items' in data['dataset'] and data['dataset']['items']:
                        items = data['dataset']['items']
                        
                        # Берем последние 5 значений для усреднения
                        recent_items = items[:5]
                        values = []
                        
                        for item in recent_items:
                            try:
                                value = float(item.get('value', 0))
                                values.append(value)
                            except (ValueError, TypeError):
                                continue
                        
                        if values:
                            avg_value = sum(values) / len(values)
                            latest_value = values[0]
                            sensor_values[sensor_id] = latest_value
                            
                            print(f"{sensor_info['name']}: {latest_value:.1f}{sensor_info['unit']}")
                            
                            # Проверка влажности почвы
                            if sensor_id == 19 and latest_value < sensor_info['min']:
                                alerts.append(f"НИЗКАЯ ВЛАЖНОСТЬ ПОЧВЫ: {latest_value:.1f}% (мин: {sensor_info['min']}%)")
                                
                        else:
                            print(f"{sensor_info['name']}: нет корректных значений")
                    else:
                        print(f"{sensor_info['name']}: нет данных за последние 24 часа")
                else:
                    print(f"{sensor_info['name']}: ошибка запроса {response.status_code}")
            
            # Анализ наличия воды в баке по разнице температур
            if 18 in sensor_values and 38 in sensor_values:
                air_temp = sensor_values[18]
                soil_temp = sensor_values[38]
                temp_difference = air_temp - soil_temp
                
                print(f"\nТЕМПЕРАТУРНЫЙ АНАЛИЗ:")
                print(f"Воздух: {air_temp:.1f}°C, Почва: {soil_temp:.1f}°C")
                print(f"Разница: {temp_difference:.1f}°C")
                
                # Критерии наличия воды в баке
                if temp_difference >= 2.0 and temp_difference <= 5.0:
                    print("ВОДА В БАКЕ: Нормальная разница температур")
                    print("Почва adequately охлаждается испарением")
                    
                elif temp_difference < 2.0:
                    alerts.append(f"ВОДА ЗАКОНЧИЛАСЬ: Разница температур всего {temp_difference:.1f}°C")
                    alerts.append("Почва не охлаждается - вероятно, бак пустой")
                    
                elif temp_difference > 5.0:
                    alerts.append(f"ПЕРЕОХЛАЖДЕНИЕ: Разница температур {temp_difference:.1f}°C")
                    alerts.append("Слишком большая разница - возможен избыточный полив")
                
                # Дополнительный анализ по влажности
                if 19 in sensor_values:
                    soil_moisture = sensor_values[19]
                    if soil_moisture < 30 and temp_difference < 2.0:
                        alerts.append("КРИТИЧЕСКАЯ СИТУАЦИЯ: Низкая влажность + нет охлаждения")
                        alerts.append("Срочно проверьте бак с водой!")
            
            # Вывод всех предупреждений
            if alerts:
                print("\nПРЕДУПРЕЖДЕНИЯ:")
                for i, alert in enumerate(alerts, 1):
                    print(f"  {i}. {alert}")
            else:
                print("\nВСЕ СИСТЕМЫ В НОРМЕ")
                print("Вода в баке присутствует, полив работает нормально")
            
            # Статистика за последние 24 часа
            print(f"\nДАННЫЕ ЗА ПОСЛЕДНИЕ 24 ЧАСА:")
            print(f"Время проверки: {current_time.strftime('%H:%M:%S')}")
            print(f"Следующая проверка через 10 минут...")
            
            time.sleep(600)  # Проверка каждые 10 минут
            
        except KeyboardInterrupt:
            print("\nМониторинг остановлен")
            break
        except Exception as e:
            print(f"Ошибка: {e}")
            time.sleep(300)

def quick_water_check():
    """Быстрая проверка наличия воды"""
    
    headers = {"Authorization": "EPP3GHY67735"}
    
    print("=== БЫСТРАЯ ПРОВЕРКА ВОДЫ В БАКЕ ===")
    
    try:
        # Получаем текущие данные
        params = {
            "start": "2025-11-01T00:00:00Z",
            "end": "2025-11-02T00:00:00Z",
            "page": 1,
            "range": 3
        }
        
        air_response = requests.get(
            "https://api.iot.robolatoriya.com/device/10/getSensorData/18", 
            headers=headers, params=params
        )
        soil_response = requests.get(
            "https://api.iot.robolatoriya.com/device/10/getSensorData/38", 
            headers=headers, params=params
        )
        
        if air_response.status_code == 200 and soil_response.status_code == 200:
            air_data = air_response.json()
            soil_data = soil_response.json()
            
            if (air_data.get('dataset', {}).get('items') and 
                soil_data.get('dataset', {}).get('items')):
                
                air_temp = float(air_data['dataset']['items'][0]['value'])
                soil_temp = float(soil_data['dataset']['items'][0]['value'])
                difference = air_temp - soil_temp
                
                print(f"Температура воздуха: {air_temp}°C")
                print(f"Температура почвы: {soil_temp}°C")
                print(f"Разница: {difference:.1f}°C")
                
                if 2.0 <= difference <= 5.0:
                    print("ВОДА В БАКЕ: ЕСТЬ")
                else:
                    print("ВОДА В БАКЕ: ПРОБЛЕМА")
                    
        else:
            print("Ошибка получения данных")
            
    except Exception as e:
        print(f"Ошибка: {e}")

# Запуск
if __name__ == "__main__":
    print("Выберите режим:")
    print("1 - Полный мониторинг (каждые 10 минут)")
    print("2 - Быстрая проверка")
    
    choice = input("Введите номер: ").strip()
    
    if choice == "1":
        smart_greenhouse_water_monitor()
    elif choice == "2":
        quick_water_check()
    else:
        print("Запуск полного мониторинга...")
        smart_greenhouse_water_monitor()
